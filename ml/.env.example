# Anthropic API key, required for the /ai/chat clinical interpretation endpoint.
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used by the chat (default claude-opus-5-5).
# CLAUDE_MODEL=claude-opus-5-5

# CORS: comma-separated allowed origins. Leave unset (*) for local development.
# ALLOWED_ORIGINS=https://your-domain.com

# Data location (default ../data). In Docker this is /data.
# DATA_ROOT=/data
